{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centry-agent-runner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "centry-agents",
      "database_id": "YOUR_CLOUDFLARE_D1_DATABASE_ID"
    }
  ]
}
